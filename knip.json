{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["tools/oxlint/anti-slop/**"],
  "ignoreDependencies": ["@effect/language-service"],
  "workspaces": {
    "apps/editor": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "apps/launcher": {
      "entry": ["src/compiled.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@reebeat-studio/editor"]
    },
    "tools/quality": {
      "entry": ["checkEffectExceptions.ts"],
      "project": ["*.ts", "test/**/*.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks"]
}
